# Copy to .env and fill in. Never commit .env.

# Google AI Studio key: https://aistudio.google.com/apikey
# Leave empty to run with the offline rule engine only.
GEMINI_API_KEY=
# One model or a comma-separated fallback list (next is tried when one is overloaded).
GEMINI_MODEL=gemini-2.5-flash,gemini-flash-latest,gemini-flash-lite-latest

# LINE Developers console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

DATABASE_PATH=data/scam_alert.db

# Fill the dashboard with demo data when the database is empty (useful on free hosting).
SEED_DEMO_IF_EMPTY=false
